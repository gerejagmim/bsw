        /* Memastikan aplikasi memenuhi seluruh layar HP/Laptop tanpa terpotong */
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            overflow: hidden; /* Mencegah munculnya scrollbar ganda */
